# Brand assets — clients drop their own logos here. Keep them out of the
# template repo so each instance ships with only the bot owner's branding.
public/*.webp
public/*.png
public/*.jpg
public/*.jpeg
public/*.svg
!public/.gitkeep
!public/logo.png
.env*

# Session-only temp scripts (ingestion/derivation shims created and deleted
# within a single working session) — never meant to be committed.
scripts/_session_*.mjs
scripts/_session_*.ts
